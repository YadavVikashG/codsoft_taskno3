DATABASE_URL=postgres://localhost:5432/careerhub

# Google OAuth. Register this callback URL in Google Cloud:
# http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Optional S3-compatible resume storage (AWS S3, Cloudflare R2, etc.).
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
